---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusBar from "../components/sounding/StatusBar.astro";
import SourceTabs from "../components/sounding/SourceTabs.astro";
import SourceForms from "../components/sounding/SourceForms.astro";
import FigureSettings from "../components/sounding/FigureSettings.astro";
import SoundingResult from "../components/sounding/SoundingResult.astro";
import SoundingFooter from "../components/sounding/SoundingFooter.astro";
import ErrorDialog from "../components/sounding/ErrorDialog.astro";
import ImageViewer from "../components/sounding/ImageViewer.astro";
import "../styles/sounding-analysis.css";
const title = "SounderPy Sounding Analysis";
const description = "Plot observed, aircraft, model forecast, and reanalysis soundings with SounderPy right in your browser.";
---
<BaseLayout title={title} description={description}>
  <article class="container spy">
    <!-- The site header shows the title; this keeps a page heading for screen readers. -->
    <h1 class="spy-sr-only">{title}</h1>

    <StatusBar />
    <SourceTabs />
    <SourceForms />
    <FigureSettings />
    <SoundingResult />
    <SoundingFooter />
    <ErrorDialog />
    <ImageViewer />
  </article>
</BaseLayout>

<script>
  import "../scripts/sounding-app.js";
</script>
