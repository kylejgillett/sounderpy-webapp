---
import '../styles/global.css';
import { sitePath } from '../utils/site-path.js';
import NavLink from '../components/NavLink.astro';
const { title = 'SounderPy Sounding Analysis', description = 'Plot observed, aircraft, model forecast, and reanalysis soundings with SounderPy, right in your browser.' } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = currentPath === (sitePath('/').replace(/\/+$/, '') || '/');

// Switch Documentation to https://docs.sounderpy.app/ once that domain is live.
const links = [
  { label: 'Build Soundings', href: sitePath('/'), icon: 'sounding', current: isHome },
  { label: 'Documentation', href: 'https://kylejgillett.github.io/sounderpy/', icon: 'book', external: true },
  { label: 'Source Code', href: 'https://github.com/kylejgillett/sounderpy', icon: 'code', external: true },
  { label: 'Support', href: 'https://www.buymeacoffee.com/kylejgillett', icon: 'coffee', external: true },
  { label: 'Author', href: 'https://kylegillettphoto.com/', icon: 'person', external: true },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title.includes('SounderPy') ? title : `${title} | SounderPy Sounding Analysis`}</title>
    <link rel="icon" href={sitePath('/favicon.png')} type="image/png" />
  </head>
  <body>
    <header class="site-header" style={`--header-map: url("${sitePath('/500_heights.gif')}")`}>
      <a class="brand" href={sitePath('/')}>
        <img class="brand-logo" src={sitePath('/sounderpy-logo.png')} width="160" height="160" alt="" />
        <span class="brand-text">SounderPy Sounding Analysis<span>An atmospheric sounding visualization and analysis tool for Python <em>(and your browser!)</em></span></span>
      </a>
      <nav aria-label="Main navigation">
        <div class="site-nav-links">
          {links.map((l) => <NavLink {...l} />)}
        </div>
        <details class="site-nav-mobile">
          <summary>Menu</summary>
          <div class="site-nav-mobile-links">
            {links.map((l) => <NavLink {...l} />)}
          </div>
        </details>
      </nav>
    </header>
    <main><slot /></main>
    <footer><span>© {new Date().getFullYear()} Kyle J. Gillett · SounderPy is open source</span></footer>
  </body>
</html>
