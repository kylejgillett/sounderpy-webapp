---
import '../styles/global.css';
import { sitePath } from '../utils/site-path.js';
import NavLink from '../components/NavLink.astro';
import { RELEASES } from '../data/whats-new.js';
const { title = 'SounderPy Sounding Analysis', description = 'Plot observed, aircraft, model forecast, and reanalysis soundings with SounderPy, right in your browser.' } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = currentPath === (sitePath('/').replace(/\/+$/, '') || '/');
const pageTitle = title.includes('SounderPy') ? title : `${title} | SounderPy Sounding Analysis`;
// Link previews (Slack, Discord, iMessage, social media) need absolute URLs.
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const cardUrl = new URL(sitePath('/og-card.jpg'), Astro.site);

// Switch Documentation to https://docs.sounderpy.app/ once that domain is live.
const links = [
  { label: 'Build Soundings', href: sitePath('/'), icon: 'wrench', current: isHome },
  { label: 'Documentation', href: 'https://kylejgillett.github.io/sounderpy/', icon: 'book', external: true },
  { label: 'Source Code', href: 'https://github.com/kylejgillett/sounderpy', icon: 'code', external: true },
  { label: 'Support', href: 'https://www.buymeacoffee.com/kylejgillett', icon: 'coffee', external: true },
  { label: 'Author', href: 'https://kylegillettphoto.com/', icon: 'person', external: true },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SounderPy" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SounderPy Sounding Analysis: a dark-mode sounding and hodograph for Moore, Oklahoma, 20 May 2013, next to the SounderPy logo." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={sitePath('/favicon.png')} type="image/png" />
  </head>
  <body>
    <header class="site-header" style={`--header-map: url("${sitePath('/500_heights.gif')}")`}>
      <a class="brand" href={sitePath('/')}>
        <img class="brand-logo" src={sitePath('/sounderpy-logo.png')} width="160" height="160" alt="" />
        <span class="brand-text">sounderpy.app<span>An atmospheric sounding visualization and analysis tool for Python <em>(and your browser!)</em></span></span>
      </a>
      <nav aria-label="Main navigation">
        <div class="site-nav-links">
          {links.map((l) => <NavLink {...l} />)}
        </div>
        <details class="site-nav-mobile">
          <summary>Menu</summary>
          <div class="site-nav-mobile-links">
            {links.map((l) => <NavLink {...l} />)}
          </div>
        </details>
      </nav>
    </header>
    <main><slot /></main>
    <footer><span>© {new Date().getFullYear()} Kyle J. Gillett · SounderPy is open source · sounderpy.app v{RELEASES[0].version}</span></footer>
  </body>
</html>
