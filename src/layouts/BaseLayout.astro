---
import '../styles/global.css';
import { sitePath } from '../utils/site-path.js';
const { title = 'SounderPy Soundings', description = 'Plot observed, aircraft, model forecast, and reanalysis soundings with SounderPy, right in your browser.' } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = currentPath === (sitePath('/').replace(/\/+$/, '') || '/');

// Switch Documentation to https://docs.sounderpy.app/ once that domain is live.
const links = [
  { label: 'Build Soundings', href: sitePath('/'), current: isHome },
  { label: 'Documentation', href: 'https://kylejgillett.github.io/sounderpy/' },
  { label: 'Source Code', href: 'https://github.com/kylejgillett/sounderpy' },
  { label: 'Support', href: 'https://www.buymeacoffee.com/kylejgillett' },
  { label: 'Author', href: 'https://kylegillettphoto.com/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title.includes('SounderPy') ? title : `${title} | SounderPy Soundings`}</title>
    <link rel="icon" href={sitePath('/favicon.png')} type="image/png" />
  </head>
  <body>
    <header class="site-header" style={`--header-map: url("${sitePath('/500_heights.gif')}")`}>
      <a class="brand" href={sitePath('/')}>SounderPy Soundings<span>Sounding analysis and visualization, right in your browser.</span></a>
      <nav aria-label="Main navigation">
        <div class="site-nav-links">
          {links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
        </div>
        <details class="site-nav-mobile">
          <summary>Menu</summary>
          <div class="site-nav-mobile-links">
            {links.map((l) => <a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
          </div>
        </details>
      </nav>
    </header>
    <main><slot /></main>
    <footer><span>© {new Date().getFullYear()} Kyle J. Gillett · SounderPy is open source</span></footer>
  </body>
</html>
