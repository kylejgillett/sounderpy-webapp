---
// Composite tab: build a list of profiles, then plot them together. The "Add profile"
// pop-up borrows the regular request forms (moved in by sounding-app.js).
const types = [
  ["raob", "Observed (RAOB)"],
  ["acars", "Aircraft (ACARS)"],
  ["bufkit", "Model Forecast (BUFKIT)"],
  ["reanalysis", "Reanalysis (RAP-RUC)"],
];
const schemes = ["Viridis", "Plasma", "Cividis", "Turbo", "Coolwarm"];
---
<section class="spy-composite" data-composite hidden>
  <p class="spy-experimental"><b>Experimental</b> This tool is new, so expect it to change as it develops.</p>
  <div class="spy-composite-main">
    <div class="spy-composite-head">
      <h3>Profiles</h3>
      <span class="spy-profile-count"></span>
    </div>
    <p class="spy-profile-empty">No profiles yet. Add at least two to compare them on one plot.</p>
    <ol class="spy-profile-list"></ol>
    <button class="spy-secondary spy-profile-add" type="button" data-add-profile>+ Add profile</button>
  </div>

  <div class="spy-side">
    <p class="spy-hint">Overlay up to 6 soundings on one Skew-T and hodograph. Mix any data types, sites, and times.</p>
    <div class="spy-composite-options">
      <label class="spy-check"><input type="checkbox" name="dark_mode" checked />Dark mode</label>
      <label class="spy-check"><input type="checkbox" name="shade_between" checked />Shade between temperature and dewpoint</label>
      <label>Line colors<select name="cmap">{schemes.map((s) => <option value={s.toLowerCase()}>{s}</option>)}<option value="custom">Custom (choose per profile)</option></select></label>
    </div>
    <div class="spy-actions">
      <button class="spy-submit" type="button" data-build-composite disabled><span>Build composite</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m0 0-5-5m5 5-5 5" /></svg></button>
    </div>
  </div>
</section>

<dialog class="spy-profile-dialog" aria-labelledby="spy-profile-title">
  <header class="spy-settings-head">
    <h2 id="spy-profile-title">Add a profile</h2>
    <button class="spy-settings-x" type="button" data-close-profile aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
  </header>
  <div class="spy-profile-types" role="group" aria-label="Data type">
    {types.map(([type, label]) => <button type="button" data-profile-type={type} aria-pressed="false">{label}</button>)}
  </div>
  <div class="spy-profile-slot"></div>
</dialog>

<dialog class="spy-series" aria-labelledby="spy-series-title">
  <header class="spy-settings-head">
    <h2 id="spy-series-title">Build a forecast timeseries</h2>
    <button class="spy-settings-x" type="button" data-close-series aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
  </header>
  <div class="spy-series-body">
    <p class="spy-series-source"></p>
    <div class="spy-series-fields">
      <label>From forecast hour<input name="series_from" type="number" min="0" step="1" /></label>
      <label>To forecast hour<input name="series_to" type="number" min="0" step="1" /></label>
      <label>Every (hours)<input name="series_every" type="number" min="1" step="1" /></label>
    </div>
    <p class="spy-series-preview" aria-live="polite"></p>
    <div class="spy-radios spy-series-mode" role="radiogroup" aria-label="Existing profiles">
      <span>Your list has profiles</span>
      <label><input type="radio" name="series_mode" value="replace" /><span>Replace them</span></label>
      <label><input type="radio" name="series_mode" value="add" checked /><span>Add to them</span></label>
    </div>
  </div>
  <div class="spy-settings-actions">
    <button class="spy-secondary" type="button" data-close-series>Cancel</button>
    <button class="spy-secondary spy-settings-done" type="button" data-create-series>Create composite</button>
  </div>
</dialog>
