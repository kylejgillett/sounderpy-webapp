---
// Bottom of each request form: open the figure settings, then get the sounding.
---
<div class="spy-actions">
  <button class="spy-settings-open" type="button" data-open-settings aria-haspopup="dialog">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h10m4 0h2M4 12h4m4 0h8M4 18h12m4 0h0" /><circle cx="16" cy="6" r="2" /><circle cx="10" cy="12" r="2" /><circle cx="18" cy="18" r="2" /></svg>
    <span>Customize figure</span>
    <span class="spy-settings-count" hidden></span>
  </button>
  <button class="spy-submit" type="submit"><span>Get sounding</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m0 0-5-5m5 5-5 5" /></svg></button>
</div>
