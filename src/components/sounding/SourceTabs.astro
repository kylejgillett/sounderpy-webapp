---
// Data-source tabs; sounding-app.js shows the matching form from SourceForms.
---
<div class="spy-tabs" role="tablist" aria-label="Data source">
  <button type="button" role="tab" data-tab="raob" aria-selected="true">Observed (RAOB)</button>
  <button type="button" role="tab" data-tab="acars" aria-selected="false">Aircraft (ACARS)</button>
  <button type="button" role="tab" data-tab="bufkit" aria-selected="false">Model Forecast (BUFKIT)</button>
  <button type="button" role="tab" data-tab="reanalysis" aria-selected="false">Reanalysis (RAP-RUC)</button>
  <button type="button" role="tab" data-tab="composite" aria-selected="false">Composite soundings</button>
</div>
